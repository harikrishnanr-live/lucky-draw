# URL Rewriting for Clean Routes
RewriteEngine On

# Redirect /admin to admin login page
RewriteRule ^admin/?$ admin/login.php [L,QSA]

# Redirect /admin/login to admin login page
RewriteRule ^admin/login/?$ admin/login.php [L,QSA]

# Redirect /admin/dashboard to admin dashboard
RewriteRule ^admin/dashboard/?$ admin/dashboard.php [L,QSA]

# Redirect /admin/logout to admin logout
RewriteRule ^admin/logout/?$ admin/logout.php [L,QSA]

# Redirect /admin/authenticate to admin authenticate
RewriteRule ^admin/authenticate/?$ admin/authenticate.php [L,QSA]

# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^(database\.php|db_connect\.php|session_check\.php|seed_admin\.php|run_migrations\.php)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect migration files
<FilesMatch "\.sql$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Protect config directory
<IfModule mod_rewrite.c>
    RewriteRule ^config/ - [F,L]
</IfModule>

# Default index file
DirectoryIndex index.html index.php

# Set default charset
AddDefaultCharset UTF-8

# Enable gzip compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
</IfModule>
